---
import Base from '../layouts/Base.astro';
import RequestForm from '../components/RequestForm.astro';
import { city, C, services, guides, neighborhoods } from '../data/city';
import { faqSchema } from '../lib/seo';
import { business } from '../lib/site';
import { u } from '../lib/utils';
import { pageImage } from '../lib/pageImages';
const home = city.home;
const [s1, s2, s3, s4] = home.sections;
const faqs = home.faqs;
const steps = home.steps;
const svcImgs = services.map((s) => pageImage(s.slug + s.name));
const aboutA = pageImage('about-a-' + home.h1);
const aboutB = pageImage('about-b-' + home.h1);
---
<Base title={home.title} description={home.desc} path="/" extraSchema={[faqSchema(faqs)]} noFormBand={true}>
  <section class="hero hero--light" data-parallax-stage>
    <div class="fx-circle fx-fill fx-float" data-depth="16" style="width:460px;height:460px;left:-190px;bottom:-210px" aria-hidden="true"></div>
    <div class="fx-circle fx-ring-dark fx-float-slow" data-depth="28" style="width:150px;height:150px;right:30%;top:-60px" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-copy-col reveal">
        <span class="hero-script">{city.ui.heroEyebrow}</span>
        <h1>{home.h1}</h1>
        <p class="hero-copy">{home.intro}</p>
        <div class="hero-cta">
          <a class="button-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
          <a class="link-underline" href={u('/services/')}>Our expertise</a>
        </div>
      </div>
      <div class="hero-form-wrap reveal" style="--reveal-delay:.15s">
        <RequestForm location="Homepage" />
      </div>
    </div>
  </section>

  <section class="content-section"><div class="content-inner about-grid">
    <div class="about-collage reveal" data-parallax-stage>
      <div class="fx-circle fx-ring-dark fx-float-slow" data-depth="14" style="width:120px;height:120px;left:-44px;bottom:30px" aria-hidden="true"></div>
      <img class="img-a" src={u(aboutA.src)} alt={aboutA.alt} width="800" height="600" loading="lazy" decoding="async" />
      <img class="img-b" src={u(aboutB.src)} alt={aboutB.alt} width="600" height="450" loading="lazy" decoding="async" />
      <div class="about-badge" aria-hidden="true">{city.site.city}, {city.site.region}</div>
    </div>
    <div class="about-copy reveal" style="--reveal-delay:.12s">
      <p class="eyebrow">About us</p>
      <h2 class="section-title">{s4.h}</h2>
      {s4.ps.map((p) => <p class="section-intro" set:html={p} />)}
      <ul class="check-list">{services.map((s) => <li><a href={u(`/services/${s.slug}/`)}>{s.shortName}</a></li>)}</ul>
      <a class="button-primary" href="#request-service">Get started</a>
    </div>
  </div></section>

  <section class="content-section content-section-alt" data-parallax-stage>
    <div class="fx-circle fx-ring-dark fx-float" data-depth="16" style="width:220px;height:220px;right:-90px;top:-80px" aria-hidden="true"></div>
    <div class="content-inner">
      <div class="section-head reveal"><p class="eyebrow">Services</p><h2 class="section-title">{s1.h}</h2><p class="section-intro">{s1.ps[0]}</p></div>
      <div class="card-grid">
        {services.map((s, i) => (
          <article class="svc-card reveal" style={`--reveal-delay:${i * 0.12}s`}>
            <a class="svc-media" href={u(`/services/${s.slug}/`)} tabindex="-1" aria-hidden="true"><img src={u(svcImgs[i].src)} alt={svcImgs[i].alt} width="800" height="500" loading="lazy" decoding="async" /></a>
            <div class="svc-body">
              <p class="eyebrow" style="margin:0">Service {String(i + 1).padStart(2, '0')}</p>
              <h3><a href={u(`/services/${s.slug}/`)}>{s.name}</a></h3>
              <p>{s.blurb}</p>
              <a class="link-underline" href={u(`/services/${s.slug}/`)}>View details</a>
            </div>
          </article>
        ))}
        <article class="card card-spec reveal" style={`--reveal-delay:${services.length * 0.12}s`}>
          <p class="eyebrow">Method guides</p>
          <h3>Good to know</h3>
          <p>Short guides on how the work goes and how the common methods compare.</p>
          <ul class="check-list">{guides.map((g) => <li><a href={u(`/guides/${g.slug}/`)}>{g.name}</a></li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <section class="content-section" data-parallax-stage>
    <div class="fx-circle fx-fill fx-float" data-depth="18" style="width:200px;height:200px;left:-80px;bottom:-70px" aria-hidden="true"></div>
    <div class="content-inner">
      <div class="section-head reveal"><p class="eyebrow">Work process</p><h2 class="section-title">How a visit goes</h2></div>
      <div class="card-grid card-grid-3">
        {steps.map((s, i) => (
          <article class="card reveal" style={`--reveal-delay:${i * 0.12}s`}>
            <span class="card-icon" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dark-band" data-parallax-stage>
    <div class="fx-circle fx-ring fx-float" data-depth="20" style="width:270px;height:270px;right:-110px;top:-120px;opacity:.35" aria-hidden="true"></div>
    <div class="fx-circle fx-ring fx-float-slow" data-depth="30" style="width:110px;height:110px;left:4%;bottom:-40px;opacity:.3" aria-hidden="true"></div>
    <div class="dark-grid">
      <div class="reveal">
        <p class="eyebrow eyebrow-light">Local area pages</p>
        <h2 class="section-title section-title-light">{s3.h}</h2>
        <p class="band-text">{home.bandText}</p>
        <div class="pill-grid pill-grid-dark">{neighborhoods.map((n) => <a class="pill" href={u(`/neighborhood/${n.slug}/`)}>{n.name}</a>)}</div>
      </div>
      <aside class="dispatch-card reveal" style="--reveal-delay:.15s"><p class="eyebrow">Phone line</p><h3>{home.dispatchTitle}</h3><p>{home.dispatchText}</p><a class="button-dark" href={business.phoneHref}>Call {business.phoneDisplay}</a></aside>
    </div>
  </section>

  <section class="content-section"><div class="content-inner">
    <div class="reveal"><p class="eyebrow">Before you book</p><h2 class="section-title">{s2.h}</h2></div>
    {s2.ps.map((p) => <p class="section-intro reveal" style="margin-bottom:14px" set:html={p} />)}
  </div></section>

  <section class="content-section content-section-alt"><div class="content-inner acc-grid">
    <div class="reveal">
      <p class="eyebrow">FAQ</p>
      <h2 class="section-title">{home.faqHeading}</h2>
      <div class="acc-side-card">
        <h3>{home.dispatchTitle}</h3>
        <p>{home.dispatchText}</p>
        <a class="button-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
      </div>
    </div>
    <div class="acc reveal" style="--reveal-delay:.12s">
      {faqs.map((f, i) => (
        <div class:list={['acc-item', { open: i === 0 }]} data-acc-item>
          <button class="acc-toggle" type="button" data-acc-toggle aria-expanded={i === 0 ? 'true' : 'false'}>
            <h3>{f.q}</h3>
            <span class="acc-icon" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6.5 1v11M1 6.5h11"/></svg></span>
          </button>
          <div class="acc-panel" data-acc-panel aria-hidden={i === 0 ? 'false' : 'true'}><div class="acc-panel-inner"><p>{f.a}</p></div></div>
        </div>
      ))}
    </div>
  </div></section>
<section class="nh-body"><div class="nh-inner"><p set:html={home.footerLinksHtml.replace(/href="(\/[^"]*)"/g, (_m, h) => 'href="' + u(h) + '"')} /></div></section>
</Base>
